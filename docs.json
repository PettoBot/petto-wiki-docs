{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Petto",
  "colors": {
    "primary": "#fde52f",
    "light": "#9c7b00",
    "dark": "#fde52f"
  },
  "background": {
    "color": {
      "light": "#faf8f3",
      "dark": "#1e1d1b"
    }
  },
  "favicon": "favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "overview/introduction",
          "overview/getting-started"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/first-server-setup",
          "guides/ticket-system-setup",
          "guides/migrating-from-another-bot"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/cases",
          "concepts/variables-engine",
          "concepts/permissions-and-hierarchy"
        ]
      },
      {
        "group": "Moderation",
        "pages": [
          "moderation/moderation",
          "moderation/automod",
          "moderation/anti-nuke",
          "moderation/logging"
        ]
      },
      {
        "group": "Automation",
        "pages": [
          "automation/reaction-roles",
          "automation/custom-commands",
          "automation/autoresponder",
          "automation/sticky-messages",
          "automation/disable-commands"
        ]
      },
      {
        "group": "Community",
        "pages": [
          "community/tickets",
          "community/leveling",
          "community/leveling-rewards",
          "community/giveaways",
          "community/giveaway-presets",
          "community/reminders",
          "community/invites",
          "community/afk",
          "community/boosterrole",
          "community/reports"
        ]
      },
      {
        "group": "Onboarding",
        "pages": [
          "onboarding/welcome",
          "onboarding/leave",
          "onboarding/boost",
          "onboarding/dm-on-join",
          "onboarding/bump-reminder",
          "onboarding/ping-on-join",
          "onboarding/verification"
        ]
      },
      {
        "group": "Setup",
        "pages": [
          "setup/prefix",
          "setup/bot-appearance",
          "setup/config-export"
        ]
      },
      {
        "group": "Resources",
        "pages": [
          {
            "group": "Scripting",
            "icon": "scroll",
            "pages": [
              "resources/scripting/variables",
              "resources/scripting/embeds"
            ]
          },
          "resources/utility-commands"
        ]
      },
      {
        "group": "Common Issues",
        "pages": [
          "common-issues/faq",
          "common-issues/permissions",
          "common-issues/dashboard-issues"
        ]
      },
      {
        "group": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "logo": {
    "light": "/favicon.png",
    "dark": "/favicon.png"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "navbar": {
    "links": [
      {
        "label": "Support Server",
        "href": "https://petto.sbs/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Add Petto",
      "href": "https://petto.sbs/invite"
    }
  },
  "seo": {
    "metatags": {
      "theme-color": "#fde52f",
      "og:site_name": "petto.sbs",
      "og:title": "Petto Documentation",
      "og:description": "Every command, module, and variable Petto supports, with real examples.",
      "og:image": "/og-image.png",
      "twitter:card": "summary_large_image"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "discord": "https://petto.sbs/support"
    }
  },
  "redirects": [
    {
      "source": "/invite",
      "destination": "https://petto.sbs/invite"
    },
    {
      "source": "/discord",
      "destination": "https://petto.sbs/support"
    }
  ]
}
